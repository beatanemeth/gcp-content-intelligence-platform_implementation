{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"attribution": {
		"commit": ""
	},
	"permissions": {
		"additionalDirectories": ["../gcp-content-intelligence-platform_planning"],
		"allow": [
			"Bash(terraform fmt*)",
			"Bash(terraform init -backend=false*)",
			"Bash(terraform validate*)",
			"Bash(terraform test*)",
			"Bash(tflint*)",
			"Bash(pytest*)",
			"Bash(python -m pytest*)",
			"Bash(ruff check*)",
			"Bash(ruff format*)",
			"Bash(shellcheck *)",
			"Bash(pre-commit run*)"
		],
		"ask": [
			"Bash(terraform init -backend-config*)",
			"Bash(terraform plan*)",
			"Bash(terraform output*)",
			"Bash(terraform state list*)",
			"Bash(terraform state show*)",
			"Bash(gcloud *)",
			"Bash(gsutil *)",
			"Bash(bq *)"
		],
		"deny": [
			"Bash(terraform apply*)",
			"Bash(terraform * apply*)",
			"Bash(terraform destroy*)",
			"Bash(terraform * destroy*)",
			"Bash(terraform import*)",
			"Bash(terraform refresh*)",
			"Bash(terraform taint*)",
			"Bash(terraform untaint*)",
			"Bash(terraform force-unlock*)",
			"Bash(terraform state rm*)",
			"Bash(terraform state mv*)",
			"Bash(terraform state push*)",
			"Bash(terraform state replace-provider*)",
			"Bash(helpers/bootstrap.sh*)",
			"Bash(./helpers/bootstrap.sh*)",
			"Bash(bash *bootstrap.sh*)",
			"Bash(sh *bootstrap.sh*)",
			"Bash(helpers/upload_data.sh*)",
			"Bash(./helpers/upload_data.sh*)",
			"Bash(bash *upload_data.sh*)",
			"Bash(sh *upload_data.sh*)",
			"Bash(bq load*)",
			"Bash(bq mk*)",
			"Bash(bq rm*)",
			"Bash(bq cp*)",
			"Bash(bq update*)",
			"Bash(bq insert*)",
			"Bash(bq extract*)",
			"Bash(gcloud * create*)",
			"Bash(gcloud * delete*)",
			"Bash(gcloud * update*)",
			"Bash(gcloud * deploy*)",
			"Bash(gcloud * enable*)",
			"Bash(gcloud * disable*)",
			"Bash(gcloud * link*)",
			"Bash(gcloud * unlink*)",
			"Bash(gcloud * add-iam-policy-binding*)",
			"Bash(gcloud * remove-iam-policy-binding*)",
			"Bash(gcloud * set-iam-policy*)",
			"Bash(gcloud storage cp*)",
			"Bash(gcloud storage mv*)",
			"Bash(gcloud storage rm*)",
			"Bash(gcloud storage rsync*)",
			"Bash(gsutil cp*)",
			"Bash(gsutil mv*)",
			"Bash(gsutil rm*)",
			"Bash(gsutil rsync*)"
		]
	}
}
