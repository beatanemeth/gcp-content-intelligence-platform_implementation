" style="shape=note;size=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="1463" width="220" height="28" as="geometry"/></mxCell><mxCell id="legend_png" value="Screenshot: Print Screen, PNG" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1035" y="1463" width="220" height="28" as="geometry"/></mxCell><mxCell id="legend_note" value='Text files are written by the command itself, in the same line: &lt;font face="Courier New"&gt;&amp;lt;command&amp;gt; 2&amp;gt;&amp;amp;1 | tee .build/real-run/&amp;lt;file&amp;gt;&lt;/font&gt; (CSV files: without 2&amp;gt;&amp;amp;1). No second command, no terminal screenshots. Full dataset: no records or author names in any screenshot.' style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="800" y="1498" width="455" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
