<mxfile host="drawio"><diagram id="deployment" name="Deployment steps"><mxGraphModel dx="1300" dy="1680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1573" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Deployment to real GCP: steps, checks and records&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="Details: notes/deployment.md. Every command runs in the laptop's terminal, from the repository root. Records go to .build/real-run/ (git-ignored)." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="70" y="40" width="1100" height="20" as="geometry"/></mxCell><mxCell id="h_step" value="Step and main commands" style="text;html=1;fontStyle=1;fontSize=13;align=left;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="70" y="75" width="480" height="25" as="geometry"/></mxCell><mxCell id="h_pass" value="Done when" style="text;html=1;fontStyle=1;fontSize=13;align=left;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="565" y="75" width="220" height="25" as="geometry"/></mxCell><mxCell id="h_txt" value="Text file (command output)" style="text;html=1;fontStyle=1;fontSize=13;align=left;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="800" y="75" width="220" height="25" as="geometry"/></mxCell><mxCell id="h_png" value="Screenshot (Console, browser)" style="text;html=1;fontStyle=1;fontSize=13;align=left;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1035" y="75" width="220" height="25" as="geometry"/></mxCell><mxCell id="s0" value='&lt;b&gt;0  Before you start&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;pre-commit run --all-files; pytest; terraform test&lt;br&gt;apt install google-cloud-cli&lt;br&gt;Console: billing account; choose a project ID&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="480" height="83" as="geometry"/></mxCell><mxCell id="s0_pass" value="Checks pass; gcloud --version lists bq" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="110" width="220" height="83" as="geometry"/></mxCell><mxCell id="s1" value='&lt;b&gt;1  Log in&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;gcloud auth login&lt;br&gt;gcloud auth application-default login&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="70" y="217" width="480" height="68" as="geometry"/></mxCell><mxCell id="s1_pass" value="Billing account: OPEN True" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="217" width="220" height="68" as="geometry"/></mxCell><mxCell id="s2" value='&lt;b&gt;2  Part A stand-in&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;PROJECT_ID=&amp;lt;project-id&amp;gt; BILLING_ACCOUNT=&amp;lt;billing-account-id&amp;gt; \&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;scripts/bootstrap.sh&lt;br&gt;gcloud config set project &amp;lt;project-id&amp;gt;&lt;br&gt;gcloud auth application-default set-quota-project &amp;lt;project-id&amp;gt;&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="309" width="480" height="98" as="geometry"/></mxCell><mxCell id="s2_pass" value="&amp;quot;Done. Part A is ready for Part B&amp;quot;; exit code 0" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="309" width="220" height="98" as="geometry"/></mxCell><mxCell id="s2_txt" value="bootstrap.txt" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="309" width="220" height="98" as="geometry"/></mxCell><mxCell id="s2_png" value="s2-budget.png (optional)&lt;br&gt;s2-buckets.png (optional)" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1035" y="309" width="220" height="98" as="geometry"/></mxCell><mxCell id="s3" value='&lt;b&gt;3  The 2 private files&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;cp terraform/environments/dev/terraform.tfvars.example \&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;terraform/environments/dev/terraform.tfvars&lt;br&gt;the same for backend.hcl.example&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="431" width="480" height="83" as="geometry"/></mxCell><mxCell id="s3_pass" value="Real project ID in both; git ignores both" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="431" width="220" height="83" as="geometry"/></mxCell><mxCell id="s4" value='&lt;b&gt;4  init with the real backend&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;terraform -chdir=terraform/environments/dev \&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;init -backend-config=backend.hcl&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="538" width="480" height="68" as="geometry"/></mxCell><mxCell id="s4_pass" value="Backend &amp;quot;gcs&amp;quot; configured; state list exit code 0" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="538" width="220" height="68" as="geometry"/></mxCell><mxCell id="s4_txt" value="init.txt" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="538" width="220" height="68" as="geometry"/></mxCell><mxCell id="s5" value='&lt;b&gt;5  plan and apply&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;terraform -chdir=terraform/environments/dev plan&lt;br&gt;terraform -chdir=terraform/environments/dev apply&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="630" width="480" height="84" as="geometry"/></mxCell><mxCell id="s5_pass" value="31 to add; 31 added; then No changes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="630" width="220" height="84" as="geometry"/></mxCell><mxCell id="s5_txt" value="plan.txt&lt;br&gt;apply.txt&lt;br&gt;plan-after-apply.txt" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="630" width="220" height="84" as="geometry"/></mxCell><mxCell id="s5_png" value="s5-buckets.png&lt;br&gt;s5-function.png&lt;br&gt;s5-bigquery.png&lt;br&gt;s5-iam.png" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1035" y="630" width="220" height="84" as="geometry"/></mxCell><mxCell id="s6" value='&lt;b&gt;6  Upload the dummy data&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;scripts/upload_data.sh&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="70" y="738" width="480" height="68" as="geometry"/></mxCell><mxCell id="s6_pass" value="14 objects, processed/ included" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="738" width="220" height="68" as="geometry"/></mxCell><mxCell id="s6_txt" value="upload-dummy.txt" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="738" width="220" height="68" as="geometry"/></mxCell><mxCell id="s6_png" value="s6-data-bucket.png" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1035" y="738" width="220" height="68" as="geometry"/></mxCell><mxCell id="s7" value='&lt;b&gt;7  The function&amp;#x27;s logs&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;gcloud functions logs read content-transform \&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;--region=europe-west1 --limit=50&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="70" y="830" width="480" height="68" as="geometry"/></mxCell><mxCell id="s7_pass" value="6 INFO lines; records = rows (75, 6, 11, 5, 12, 5)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="830" width="220" height="68" as="geometry"/></mxCell><mxCell id="s7_txt" value="function-logs-dummy.txt" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="830" width="220" height="68" as="geometry"/></mxCell><mxCell id="s7_png" value="s7-logs.png" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1035" y="830" width="220" height="68" as="geometry"/></mxCell><mxCell id="s8" value='&lt;b&gt;8  Data checks&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;bq query --use_legacy_sql=false &amp;lt; scripts/data_checks.sql&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="70" y="922" width="480" height="68" as="geometry"/></mxCell><mxCell id="s8_pass" value="18 rows: the 6 counts; 0 everywhere else" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="922" width="220" height="68" as="geometry"/></mxCell><mxCell id="s8_txt" value="data-checks-dummy.txt" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="922" width="220" height="68" as="geometry"/></mxCell><mxCell id="s8_png" value="s8-staging-details.png" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1035" y="922" width="220" height="68" as="geometry"/></mxCell><mxCell id="s9" value='&lt;b&gt;9  Query the views&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;bq query --use_legacy_sql=false \&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;#x27;SELECT * FROM content_analysis.tag_frequency&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ORDER BY uses DESC LIMIT 10&amp;#x27;&lt;br&gt;the same for the other views&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="70" y="1014" width="480" height="98" as="geometry"/></mxCell><mxCell id="s9_pass" value="4 CSV files, each with rows" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="1014" width="220" height="98" as="geometry"/></mxCell><mxCell id="s9_txt" value="&amp;lt;view&amp;gt;-dummy.csv (x4)" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="1014" width="220" height="98" as="geometry"/></mxCell><mxCell id="s9_png" value="s9-query-result.png" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1035" y="1014" width="220" height="98" as="geometry"/></mxCell><mxCell id="s69" value='&lt;b&gt;6 to 9 again: the full dataset&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;scripts/upload_data.sh data/raw&lt;br&gt;steps 7 to 9, with -full in the file names&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#fff2e0;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="70" y="1136" width="480" height="84" as="geometry"/></mxCell><mxCell id="s69_pass" value="Counts 113, 9, 17, 8, 18, 8; &amp;quot;&amp;lt;view&amp;gt;: same&amp;quot; (x4)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="1136" width="220" height="84" as="geometry"/></mxCell><mxCell id="s69_txt" value="upload-full.txt&lt;br&gt;function-logs-full.txt&lt;br&gt;data-checks-full.txt&lt;br&gt;&amp;lt;view&amp;gt;-full.csv (x4)" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="1136" width="220" height="84" as="geometry"/></mxCell><mxCell id="s69_png" value="s9-full-logs.png" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1035" y="1136" width="220" height="84" as="geometry"/></mxCell><mxCell id="s10" value='&lt;b&gt;10  destroy&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;terraform -chdir=terraform/environments/dev destroy&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="70" y="1244" width="480" height="68" as="geometry"/></mxCell><mxCell id="s10_pass" value="31 destroyed; only the -tfstate bucket left" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="1244" width="220" height="68" as="geometry"/></mxCell><mxCell id="s10_txt" value="destroy.txt&lt;br&gt;after-destroy.txt" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="1244" width="220" height="68" as="geometry"/></mxCell><mxCell id="s10_png" value="s10-buckets-after.png" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1035" y="1244" width="220" height="68" as="geometry"/></mxCell><mxCell id="s11" value='&lt;b&gt;11  Delete the project&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;gcloud projects delete &amp;lt;project-id&amp;gt;&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="70" y="1336" width="480" height="68" as="geometry"/></mxCell><mxCell id="s11_pass" value="DELETE_REQUESTED" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="1336" width="220" height="68" as="geometry"/></mxCell><mxCell id="e_s0_s1" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s1_s2" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s2_s3" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="s2